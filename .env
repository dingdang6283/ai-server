# ============================================
# DingDing AI Cloud - 环境变量配置
# ============================================
# 复制此文件为 .env 并根据需要修改
# 环境变量优先级高于 config.yml

# --- 后端配置 (server.py 读取) ---

# SMTP 配置（可用环境变量 YML_SMTP_* 覆盖）
# YML_SMTP_DISPLAY_NAME=
# YML_SMTP_SENDER_EMAIL=
# YML_SMTP_USERNAME=
# YML_SMTP_PASSWORD=
# YML_SMTP_SERVER=
# YML_SMTP_PORT=
# YML_SMTP_ENCRYPTION=

# API 配置
# YML_API_XFYUN_PASSWORD=

# 代理协议版本
# YML_PROXY_PROTOCOL_VERSION=

# 企业邮箱白名单（逗号分隔）
# YML_EMAIL_WHITELIST=

# --- 前端配置 (Vite 读取) ---

# Vite 开发服务器连接的后端地址
VITE_API_HOST=localhost
VITE_API_PROTOCOL=http

# --- 前端生产配置 (Vite 读取) ---

# 生产环境 API 地址
# API_HOST=
# API_PROTOCOL=
